# Customer Support API Configuration
# Copy this file to .env and update with your actual values
# cp .env.example .env

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port the API server listens on
PORT=8080

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database type: sqlite (currently only sqlite is supported)
DB_TYPE=sqlite

# Path to SQLite database file (will be created if it doesn't exist)
DB_PATH=./data/chatbot.db

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Cache type: memory (currently only in-memory cache is supported)
CACHE_TYPE=memory

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Storage provider: local (for file uploads, attachments, etc.)
STORAGE_PROVIDER=local

# Path for local file storage
STORAGE_PATH=./data/uploads

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT secret for token signing (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production

# =============================================================================
# EXTERNAL API CONFIGURATION
# =============================================================================

# Orders API URL for fetching order details
# Options:
#   - "mock" : Use mock client (no external calls, returns sample data)
#   - URL    : Use HTTP client to call real Orders API
#              Example: https://web-api.bash.com
ORDERS_API_URL=mock

# =============================================================================
# AI / OPENAI CONFIGURATION
# =============================================================================

# AI Provider for intent classification and response generation
# Options:
#   - "mock"   : Use keyword-based mock AI (no API calls, no costs)
#   - "openai" : Use OpenAI GPT models (requires API key and credits)
AI_PROVIDER=mock

# OpenAI Configuration (only required when AI_PROVIDER=openai)
# Get your API key from: https://platform.openai.com/api-keys

# OpenAI API key (REQUIRED when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-your-api-key-here

# OpenAI model to use
# Recommended: gpt-4o (latest, best quality)
# Alternatives: gpt-4o-mini (faster, cheaper), gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# Maximum tokens for response generation
# Lower = cheaper, faster | Higher = more detailed responses
# Recommended: 300-500 for customer support
OPENAI_MAX_TOKENS=500

# Temperature for response generation (0.0 - 2.0)
# Lower = more focused, consistent | Higher = more creative, varied
# Recommended: 0.7 for customer support
OPENAI_TEMPERATURE=0.7

# =============================================================================
# USAGE NOTES
# =============================================================================
#
# For Local Development:
#   AI_PROVIDER=mock
#   ORDERS_API_URL=mock
#
# For Testing with Real AI (requires OpenAI credits):
#   AI_PROVIDER=openai
#   OPENAI_API_KEY=your-key
#   ORDERS_API_URL=mock
#
# For Production:
#   AI_PROVIDER=openai
#   OPENAI_API_KEY=your-production-key
#   ORDERS_API_URL=https://web-api.bash.com
#   JWT_SECRET=<generate-secure-key>
#
# =============================================================================
